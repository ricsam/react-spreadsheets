{
  "name": "@ricsam/react-spreadsheets",
  "version": "0.0.11",
  "description": "Headless-friendly React spreadsheet and workbook components: infinite virtualized grid, zoom, resizing, clipboard, fill handles and formula-engine bindings.",
  "type": "module",
  "module": "./dist/mjs/lib.mjs",
  "main": "./dist/cjs/lib.cjs",
  "types": "./dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "require": "./dist/cjs/lib.cjs",
      "import": "./dist/mjs/lib.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_ENV=production bun build-lib.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "demo": "bun demo/serve.ts"
  },
  "keywords": [
    "react",
    "spreadsheet",
    "grid",
    "workbook",
    "formula",
    "excel",
    "datagrid",
    "virtualized"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/react-spreadsheets.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ricsam/formula-engine": ">=0.2.0",
    "@ricsam/selection-manager": ">=0.0.32",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@ricsam/formula-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@ricsam/formula-engine": "^0.2.15",
    "@ricsam/selection-manager": "^0.0.32",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.2"
  }
}
